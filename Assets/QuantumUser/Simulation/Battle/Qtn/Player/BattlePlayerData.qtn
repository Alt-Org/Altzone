struct BattlePlayerData
{
    PlayerRef        PRef;
    BattlePlayerSlot Slot;
    BattleTeamNumber Team;
    bool             IsBot;
    bool             IsAbandoned;

    BattlePlayerPlayState PlayState;

    bool       StateAllowCharacterSwapping;
    bool       StatePlayerGiveUp;
    FrameTimer StateRespawnTimer;

    int                                                 SelectedCharacterNumber;
    BattleEntityID                                      CharacterEntityGroupID;
    array<FPVector2>[BATTLE_PLAYER_CHARACTER_MAX_COUNT] CharacterDefaultSpawnPositions;

    array<BattleEntityID>[BATTLE_PLAYER_CHARACTER_MAX_COUNT] ShieldEntityGroupIDs;
}
