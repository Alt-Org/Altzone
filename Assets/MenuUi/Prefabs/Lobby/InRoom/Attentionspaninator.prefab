--- !u!114 &393908166485247443
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 7138408021891807255}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 44c39ed51ce880445bcac7ac5964ba1e, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  _text1: {fileID: 4841123158537323879}
  _text2: {fileID: 837338013325124610}
  _textString1: "T\xE4ss\xE4 sit\xE4 odotellaan... *huokaus*"
  _textString2: Toivottavasti olen edes oikeassa paikassa...
  _textString3: "Eik\xF6, miksi juuri nyt pit\xE4\xE4 hikoiluttaa... Parempi olla
    n\xE4ytt\xE4m\xE4tt\xE4, ett\xE4 hermostuttaa..."
  _textString4: "Heh, tulinpa ajoissa! Nyt kaipaan kyll\xE4 muuta ajateltavaa t\xE4ss\xE4
    odotellessa."
